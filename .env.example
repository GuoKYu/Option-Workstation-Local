# Historical replay data. Market data is not distributed with this repository.
OPTION_WORKSTATION_DATA_ROOT=./data

# Cloud service binding. Listen on all interfaces inside the container.
OPTION_WORKSTATION_HOST=0.0.0.0
OPTION_WORKSTATION_PORT=7311

# Analytics configuration.
OPTION_WORKSTATION_RISK_FREE_RATE=0.043
OPTION_WORKSTATION_FRONTEND_DIST=./frontend/dist

# Append-only local research ledger.
OPTION_WORKSTATION_AUDIT_PATH=./.option-workstation/audit.jsonl

# Cloud OAuth: base URL used to build the Longbridge redirect_uri.
# When set, the backend uses {base}/api/oauth/callback instead of localhost:60355.
# You MUST add this exact redirect URI to your Longbridge OAuth app whitelist:
#   https://optionworkstation-287683-5-1253873819.sh.run.tcloudbase.com/api/oauth/callback
OW_OAUTH_REDIRECT_BASE=https://optionworkstation-287683-5-1253873819.sh.run.tcloudbase.com

RUST_LOG=option_workstation=info,tower_http=info
